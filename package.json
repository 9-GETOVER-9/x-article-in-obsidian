{
	"name": "x-article-in-obsidian",
	"version": "1.0.18",
	"description": "Obsidian plugin for previewing the current Markdown note in an X Article-style sidebar.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"sync:inject-core": "node scripts/sync-inject-core.mjs",
		"sync:inject-core:check": "node scripts/sync-inject-core.mjs --check",
		"sync:publish": "node scripts/sync-publish.mjs",
		"sync:publish:check": "node scripts/sync-publish.mjs --check"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"@eslint/js": "9.30.1",
		"jiti": "2.6.1"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
